{
  "name": "dreampc-service",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run styles && node scripts/serve.mjs",
    "styles": "sass --no-source-map --style=compressed styles/main.scss style.css",
    "styles:watch": "npm run styles -- --watch",
    "build": "node scripts/build.mjs",
    "test": "npm run styles && node scripts/verify.mjs",
    "export": "node scripts/export.mjs"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "playwright-core": "1.61.1",
    "sass": "^1.97.3"
  }
}
